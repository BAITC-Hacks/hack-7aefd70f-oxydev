# Основной бесплатный облачный экстрактор для MVP.
# Создайте .env рядом с этим файлом и вставьте новый ключ из Groq Console.
# GROQ_API_KEY=replace_with_your_groq_key
QADAM_GROQ_MODEL=openai/gpt-oss-20b
QADAM_LLM_TIMEOUT=20

# Для публичного демо обязательно задайте длинный случайный пароль.
# Локально можно оставить пустым; полноценную роле­вую модель это не заменяет.
# QADAM_DEMO_PASSWORD=replace_with_long_random_password

# Необязательно: пути к SQLite и локальным записям пилота.
# В Docker они уже находятся в постоянном томе qadam-demo.
# QADAM_PILOT_DB=/app/qadam/data/demo/pilot.sqlite3
# QADAM_PILOT_MEDIA=/app/qadam/data/demo/media

# Опциональный альтернативный провайдер. Groq имеет приоритет в auto-режиме.
# ANTHROPIC_API_KEY=sk-ant-replace_me
# QADAM_EXTRACT_MODEL=your_anthropic_model
